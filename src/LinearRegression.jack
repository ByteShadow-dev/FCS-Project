// =============================================================================
// LinearRegression.jack — Fixed Precision Linear Regression (CS207)
// =============================================================================

class LinearRegression {

    field int slopeM;        // m * 1000
    field int interceptB;    // b * 1000
    field int lr;            // learning rate step size
    field int iteration;

    field int n;              // number of data points
    field Tensor xs;          // 1xn unscaled x inputs
    field Tensor ys;          // 1xn unscaled y targets
    field Tensor yhat;        // 1xn scratch predictions (x1000)
    field Tensor err;         // 1xn scratch residuals (x1000)

    constructor LinearRegression new(int capacity, int initM, int initB, int learningRate) {
        let slopeM     = initM;
        let interceptB = initB;
        let lr         = learningRate;
        let iteration  = 0;
        let n          = 0;

        let xs   = Tensor.new(1, capacity);
        let ys   = Tensor.new(1, capacity);
        let yhat = Tensor.new(1, capacity);
        let err  = Tensor.new(1, capacity);

        return this;
    }

    method void dispose() {
        do xs.dispose();
        do ys.dispose();
        do yhat.dispose();
        do err.dispose();
        do Memory.deAlloc(this);
        return;
    }

    /** Adds raw unscaled integer point (x, y) */
    method boolean addPoint(int x, int y) {
        if (~(n < xs.getCols())) { return false; }
        do xs.set(n, x);
        do ys.set(n, y);
        let n = n + 1;
        return true;
    }

    method void clearPoints() {
        let n = 0;
        return;
    }

    method int getN() { return n; }

    /** Evaluates single point y = mx + b (returns scaled by 1000) */
    method int predictOne(int x) {
        return (slopeM * x) + interceptB;
    }

    method void computePredictions() {
        var int i, xVal;
        let i = 0;
        while (i < n) {
            let xVal = xs.get(i);
            do yhat.set(i, (slopeM * xVal) + interceptB);
            let i = i + 1;
        }
        return;
    }

    method int computeMSE() {
        var int i, e, sumSq, targetScaled;
        if (n = 0) { return 0; }
        let sumSq = 0;
        let i = 0;
        while (i < n) {
            let targetScaled = ys.get(i) * 1000;
            let e = (targetScaled - yhat.get(i)) / 100;
            let sumSq = sumSq + (e * e);
            let i = i + 1;
        }
        return sumSq / n;
    }

    method int step() {
        var int i, x, e, sumErr, sumXErr, dm, db, mse, yScaled;

        if (n < 2) { return 0; }

        do computePredictions();

        let sumErr  = 0;
        let sumXErr = 0;
        let i = 0;

        while (i < n) {
            let x = xs.get(i);
            let yScaled = ys.get(i) * 1000;
            let e = yScaled - yhat.get(i);

            let sumErr  = sumErr + e;
            let sumXErr = sumXErr + (x * e);
            let i = i + 1;
        }

        let db = (sumErr / n) / 10;
        let dm = (sumXErr / n) / 10;

        let slopeM     = slopeM + db;
        let interceptB = interceptB + dm;
        let iteration  = iteration + 1;

        do computePredictions();
        let mse = computeMSE();
        return mse;
    }

    method int getM()         { return slopeM; }
    method int getB()         { return interceptB; }
    method int getSlope()     { return slopeM; }
    method int getIntercept() { return interceptB; }
    method int getLR()        { return lr; }
    method int getIteration() { return iteration; }

    method void setLR(int newLR) { let lr = newLR; return; }

    /** Prints model summary to Hack VM output screen */
    method void print() {
        do Output.printString("LinearRegression: m=");
        do Output.printInt(slopeM);
        do Output.printString("/1000  b=");
        do Output.printInt(interceptB);
        do Output.printString("/1000  iter=");
        do Output.printInt(iteration);
        do Output.println();
        return;
    }

    method void train(int maxIter, int printEvery) {
        var int i, mse;
        let i = 0;
        while (i < maxIter) {
            let mse = step();
            if (printEvery > 0) {
                if (((i + 1) - (((i + 1) / printEvery) * printEvery)) = 0) {
                    do Output.printString("  step=");
                    do Output.printInt(i + 1);
                    do Output.printString("  MSE=");
                    do Output.printInt(mse);
                    do Output.printString("/1000");
                    do Output.println();
                }
            }
            let i = i + 1;
        }
        return;
    }
}