// =============================================================================
// LinearRegression.jack — Fixed Precision Linear Regression (CS207)
// =============================================================================

class LinearRegression {

    field int slopeM;        // m * 1000
    field int interceptB;    // b * 1000
    field int lr;            // learning rate step size
    field int iteration;

    field int n;              // number of data points
    field Tensor xs;          // 1xn unscaled x inputs
    field Tensor ys;          // 1xn unscaled y targets
    field Tensor yhat;        // 1xn scratch predictions (x1000)
    field Tensor err;         // 1xn scratch residuals (x1000)

    constructor LinearRegression new(int capacity, int initM, int initB, int learningRate) {
        let slopeM     = initM;
        let interceptB = initB;
        let lr         = learningRate;
        let iteration  = 0;
        let n          = 0;

        let xs   = Tensor.new(1, capacity);
        let ys   = Tensor.new(1, capacity);
        let yhat = Tensor.new(1, capacity);
        let err  = Tensor.new(1, capacity);

        return this;
    }

    method void dispose() {
        do xs.dispose();
        do ys.dispose();
        do yhat.dispose();
        do err.dispose();
        do Memory.deAlloc(this);
        return;
    }

    /** Adds raw or scaled point (x, y). Automatically normalizes to internal scale. */
    method boolean addPoint(int x, int y) {
        if (~(n < xs.getCols())) { return false; }
        if (~(x < 100)) {
            let x = Math.divide(x, 1000);
        }
        if (y < 100) {
            let y = Math.multiply(y, 1000);
        }
        do xs.set(n, x);
        do ys.set(n, y);
        let n = n + 1;
        return true;
    }

    method void clearPoints() {
        let n = 0;
        return;
    }

    method int getN() { return n; }

    /** Evaluates single point y = mx + b (returns scaled by 1000) */
    method int predictOne(int x) {
        if (~(x < 100)) {
            let x = Math.divide(x, 1000);
        }
        return (slopeM * x) + interceptB;
    }

    method void computePredictions() {
        var int i;
        do TensorOps.mulScalarV2(xs, slopeM, yhat);
        let i = 0;
        while (i < n) {
            do yhat.set(i, yhat.get(i) + interceptB);
            let i = i + 1;
        }
        return;
    }

    method int computeMSE() {
        var int i, e, sumSq;
        if (n = 0) { return 0; }
        let sumSq = 0;
        let i = 0;
        while (i < n) {
            let e = Math.divide(ys.get(i) - yhat.get(i), 100);
            let sumSq = sumSq + Math.divide(Math.multiply(e, e), n);
            let i = i + 1;
        }
        if (sumSq < 3276) {
            let sumSq = Math.multiply(sumSq, 10);
        }
        return sumSq;
    }

    method int step() {
        var int i, x, e, q, r, term, n2;
        var int halfMeanXE, sumE, remE, meanE;
        var int divM, divB, dm, db, mse;

        if (n < 2) { return 0; }

        do computePredictions();

        do TensorOps.subV2(ys, yhat, err);

        let n2 = n + n;
        let halfMeanXE = 0;
        let sumE = 0;
        let remE = 0;
        let i = 0;

        while (i < n) {
            let x = xs.get(i);
            let e = err.get(i);

            // Safely compute x * e / (2 * n) without 16-bit signed overflow
            let q = Math.divide(e, n2);
            let r = e - Math.multiply(q, n2);
            let term = Math.multiply(x, q) + Math.divide(Math.multiply(x, r), n2);
            let halfMeanXE = halfMeanXE + term;

            // Accumulate errors for intercept gradient
            let q = Math.divide(e, n);
            let r = e - Math.multiply(q, n);
            let sumE = sumE + q;
            let remE = remE + r;

            let i = i + 1;
        }

        let meanE = sumE + Math.divide(remE, n);

        // Gradient updates:
        // dm = 2 * (lr / 1000) * mean(x * err) = (lr / 250) * halfMeanXE = halfMeanXE / (250 / lr)
        // db = 2 * (lr / 1000) * mean(err)     = (lr / 500) * meanE      = meanE / (500 / lr)
        let divM = Math.divide(250, lr);
        let divB = Math.divide(500, lr);
        if (divM = 0) { let divM = 1; }
        if (divB = 0) { let divB = 1; }

        let dm = Math.divide(halfMeanXE, divM);
        let db = Math.divide(meanE, divB);

        let slopeM     = slopeM + dm;
        let interceptB = interceptB + db;
        let iteration  = iteration + 1;

        do computePredictions();
        let mse = computeMSE();
        return mse;
    }

    method int getX(int i) {
        return Math.multiply(xs.get(i), 1000);
    }

    method int getY(int i) {
        return ys.get(i);
    }

    method int getM()         { return slopeM; }
    method int getB()         { return interceptB; }
    method int getSlope()     { return slopeM; }
    method int getIntercept() { return interceptB; }
    method int getLR()        { return lr; }
    method int getIteration() { return iteration; }

    method void setLR(int newLR) { let lr = newLR; return; }

    /** Prints model summary to Hack VM output screen */
    method void print() {
        do Output.printString("LinearRegression: m=");
        do Output.printInt(slopeM);
        do Output.printString("/1000  b=");
        do Output.printInt(interceptB);
        do Output.printString("/1000  iter=");
        do Output.printInt(iteration);
        do Output.println();
        return;
    }

    method void train(int maxIter, int printEvery) {
        var int i, mse, j;
        let i = 0;
        while (i < maxIter) {
            let mse = step();
            if (printEvery > 0) {
                if (((i + 1) - (((i + 1) / printEvery) * printEvery)) = 0) {
                    do Output.printString("Step ");
                    do Output.printInt(i + 1);
                    do Output.printString(" (m=");
                    do Output.printInt(slopeM);
                    do Output.printString("/1k, b=");
                    do Output.printInt(interceptB);
                    do Output.printString("/1k):");
                    do Output.println();

                    let j = 0;
                    while (j < n) {
                        do Output.printString("  pt ");
                        do Output.printInt(j + 1);
                        do Output.printString(": actual y=");
                        do Output.printInt(ys.get(j));
                        do Output.printString("/1k, pred y=");
                        do Output.printInt(yhat.get(j));
                        do Output.printString("/1k");
                        do Output.println();
                        let j = j + 1;
                    }
                    do Output.println();
                }
            }
            let i = i + 1;
        }
        return;
    }
}