// Dataset (×1000 scale):
//   (x, y): (1000,2100), (2000,3000), (3000,4200), (4000,5100),
//            (5000,5800), (6000,7000), (7000,7600), (8000,8900)
//   True line ≈ y = 1.1·x + 1.0 (slope=1100/1000, intercept=1000/1000)

class LinearRegressionDemo {

    /** Run a full gradient-descent training demo and print results. */
    function void run() {
        var LinearRegression model;
        var int mse;

        do Screen.clearScreen();
        do Output.moveCursor(0, 0);
        do Output.printString("=== Linear Regression Demo ===");
        do Output.println();
        do Output.printString("Dataset: 8 points (scaled x1000)");
        do Output.println();

        // Allocate model: capacity=8, initM=500 (0.5), initB=0, lr=25 (0.025)
        let model = LinearRegression.new(8, 500, 0, 25);

        // Load dataset (×1000)
        do model.addPoint(1000, 2000);
        do model.addPoint(2000, 4000);
        do model.addPoint(3000, 6000);
        do model.addPoint(4000, 8000);
        do model.addPoint(5000, 10000);
        do model.addPoint(6000, 12000);
        do model.addPoint(7000, 14000);
        do model.addPoint(8000, 16000);

        do Output.printString("Initial: ");
        do model.print();

        // Train: 100 steps, print every 25
        do Output.printString("Training (100 steps, lr=0.025):");
        do Output.println();
        do model.train(100, 25);

        do Output.printString("Final:   ");
        do model.print();

        do Output.printString("Predictions:");
        do Output.println();
        do LinearRegressionDemo.printPredictions(model);

        do model.dispose();
        return;
    }

    /** Print predictions vs. true y for each data point directly from model. */
    function void printPredictions(LinearRegression model) {
        var int i, n, x, y, pred;
        let n = model.getN();
        let i = 0;
        while (i < n) {
            let x = model.getX(i);
            let y = model.getY(i);
            let pred = model.predictOne(x);
            do Output.printString("  x=");
            do Output.printInt(x);
            do Output.printString("/1k  y=");
            do Output.printInt(y);
            do Output.printString("/1k  yhat=");
            do Output.printInt(pred);
            do Output.printString("/1k");
            do Output.println();
            let i = i + 1;
        }
        return;
    }
}