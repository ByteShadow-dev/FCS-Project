// =============================================================================
// PolynomialRegression.jack — Quadratic Curve Fitting (y = w2*x^2 + w1*x + b)
// =============================================================================

class PolynomialRegression {
    field int w2;             // x^2 weight * 1000
    field int w1;             // x weight * 1000
    field int b;              // bias * 1000
    field int lr;             // learning rate alpha * 1000
    field int iteration;
    field int n;

    field Tensor xs;          // 1xn inputs (scaled x * 1000)
    field Tensor ys;          // 1xn targets (scaled y * 1000)
    field Tensor yhat;        // 1xn predictions
    field Tensor err;         // 1xn residual error

    constructor PolynomialRegression new(int capacity, int initW2, int initW1, int initB, int learningRate) {
        let w2 = initW2;
        let w1 = initW1;
        let b  = initB;
        let lr = learningRate;
        let iteration = 0;
        let n = 0;

        let xs   = Tensor.new(1, capacity);
        let ys   = Tensor.new(1, capacity);
        let yhat = Tensor.new(1, capacity);
        let err  = Tensor.new(1, capacity);
        return this;
    }

    method void dispose() {
        do xs.dispose();
        do ys.dispose();
        do yhat.dispose();
        do err.dispose();
        do Memory.deAlloc(this);
        return;
    }

    method boolean addPoint(int x, int y) {
        if (~(n < xs.getCols())) { return false; }
        do xs.set(n, x);
        do ys.set(n, y);
        let n = n + 1;
        return true;
    }

    method int predictOne(int x) {
        var int x2, term2, term1;
        // x2 = ( (x/10) * (x/10) ) / 10 -> prevents 16-bit signed integer overflow
        let x2 = Math.divide(Math.multiply(Math.divide(x, 10), Math.divide(x, 10)), 10);
        let term2 = Math.divide(Math.multiply(w2, x2), 1000);
        let term1 = Math.divide(Math.multiply(w1, x), 1000);
        return term2 + term1 + b;
    }

    method void computePredictions() {
        var int i, x;
        let i = 0;
        while (i < n) {
            let x = xs.get(i);
            do yhat.set(i, predictOne(x));
            let i = i + 1;
        }
        return;
    }

    method int step() {
        var int i, sumX2E, sumXE, sumE, dw2, dw1, db, x, x2, e;

        if (n < 2) { return 0; }

        do computePredictions();
        do TensorOps.subV2(ys, yhat, err);

        let sumX2E = 0;
        let sumXE  = 0;
        let sumE   = 0;
        let i = 0;
        while (i < n) {
            let x = xs.get(i);
            let e = err.get(i);
            let x2 = Math.divide(Math.multiply(Math.divide(x, 10), Math.divide(x, 10)), 10);

            let sumX2E = sumX2E + Math.divide(Math.multiply(x2, e), 1000);
            let sumXE  = sumXE  + Math.divide(Math.multiply(x, e), 1000);
            let sumE   = sumE   + e;
            let i = i + 1;
        }

        let dw2 = Math.divide(Math.multiply(lr, sumX2E), Math.multiply(n, 1000));
        let dw1 = Math.divide(Math.multiply(lr, sumXE),  Math.multiply(n, 1000));
        let db  = Math.divide(Math.multiply(lr, sumE),   Math.multiply(n, 1000));

        let w2 = w2 + dw2;
        let w1 = w1 + dw1;
        let b  = b  + db;
        let iteration = iteration + 1;

        return 0;
    }

    method int getW2() { return w2; }
    method int getW1() { return w1; }
    method int getB()  { return b;  }
}