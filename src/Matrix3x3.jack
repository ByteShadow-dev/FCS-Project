// =============================================================================
// Matrix3x3.jack — Pure Integer 3x3 Matrix Operations
// =============================================================================

class Matrix3x3 {

    // =========================================================================
    // Basic Arithmetic Operations
    // =========================================================================

    /** Element-wise Addition: out = A + B */
    function void add(Tensor a, Tensor b, Tensor out) {
        do TensorOps.addV2(a, b, out);
        return;
    }

    /** Element-wise Subtraction: out = A - B */
    function void subtract(Tensor a, Tensor b, Tensor out) {
        do TensorOps.subV2(a, b, out);
        return;
    }

    /** Standard Matrix Multiplication: out = A * B */
    function void multiply(Tensor a, Tensor b, Tensor out) {
        var int r, c, k, sum;
        let r = 0;
        while (r < 3) {
            let c = 0;
            while (c < 3) {
                let sum = 0;
                let k = 0;
                while (k < 3) {
                    let sum = sum + (a.at(r, k) * b.at(k, c));
                    let k = k + 1;
                }
                do out.put(r, c, sum);
                let c = c + 1;
            }
            let r = r + 1;
        }
        return;
    }

    /** Trace: Sum of diagonal elements (a[0][0] + a[1][1] + a[2][2]) */
    function int trace(Tensor a) {
        return a.at(0, 0) + a.at(1, 1) + a.at(2, 2);
    }

    // =========================================================================
    // Linear Transformations, Determinants & Inverse
    // =========================================================================

    /** Transpose: out = A^T */
    function void transpose(Tensor a, Tensor out) {
        var int r, c;
        let r = 0;
        while (r < 3) {
            let c = 0;
            while (c < 3) {
                do out.put(c, r, a.at(r, c));
                let c = c + 1;
            }
            let r = r + 1;
        }
        return;
    }

    /** 2x2 Determinant helper */
    function int det2x2(int a, int b, int c, int d) {
        return (a * d) - (b * c);
    }

    /** 3x3 Determinant using cofactor expansion */
    function int determinant(Tensor a) {
        var int c00, c01, c02;

        let c00 = Matrix3x3.det2x2(a.at(1, 1), a.at(1, 2), a.at(2, 1), a.at(2, 2));
        let c01 = Matrix3x3.det2x2(a.at(1, 0), a.at(1, 2), a.at(2, 0), a.at(2, 2));
        let c02 = Matrix3x3.det2x2(a.at(1, 0), a.at(1, 1), a.at(2, 0), a.at(2, 1));

        return (a.at(0, 0) * c00) - (a.at(0, 1) * c01) + (a.at(0, 2) * c02);
    }

    /** 
     * Matrix Inverse: out = adj(A) / det(A)
     * Performs integer division on each term of the adjugate matrix.
     */
    function boolean invert(Tensor a, Tensor out) {
        var int det;
        var int c00, c01, c02, c10, c11, c12, c20, c21, c22;

        let det = Matrix3x3.determinant(a);
        if (det = 0) { return false; }

        let c00 =  Matrix3x3.det2x2(a.at(1, 1), a.at(1, 2), a.at(2, 1), a.at(2, 2));
        let c01 = -Matrix3x3.det2x2(a.at(1, 0), a.at(1, 2), a.at(2, 0), a.at(2, 2));
        let c02 =  Matrix3x3.det2x2(a.at(1, 0), a.at(1, 1), a.at(2, 0), a.at(2, 1));

        let c10 = -Matrix3x3.det2x2(a.at(0, 1), a.at(0, 2), a.at(2, 1), a.at(2, 2));
        let c11 =  Matrix3x3.det2x2(a.at(0, 0), a.at(0, 2), a.at(2, 0), a.at(2, 2));
        let c12 = -Matrix3x3.det2x2(a.at(0, 0), a.at(0, 1), a.at(2, 0), a.at(2, 1));

        let c20 =  Matrix3x3.det2x2(a.at(0, 1), a.at(0, 2), a.at(1, 1), a.at(1, 2));
        let c21 = -Matrix3x3.det2x2(a.at(0, 0), a.at(0, 2), a.at(1, 0), a.at(1, 2));
        let c22 =  Matrix3x3.det2x2(a.at(0, 0), a.at(0, 1), a.at(1, 0), a.at(1, 1));

        do out.put(0, 0, c00 / det);
        do out.put(0, 1, c10 / det);
        do out.put(0, 2, c20 / det);

        do out.put(1, 0, c01 / det);
        do out.put(1, 1, c11 / det);
        do out.put(1, 2, c21 / det);

        do out.put(2, 0, c02 / det);
        do out.put(2, 1, c12 / det);
        do out.put(2, 2, c22 / det);

        return true;
    }

    // =========================================================================
    // Exact Characteristic Polynomial Eigenvalues
    // =========================================================================

    /** Evaluates characteristic polynomial p(x) = -x^3 + c2*x^2 - c1*x + c0 */
    function int evalPoly(int x, int c2, int c1, int c0) {
        var int x2, x3, term3, term2, term1;
        let x2 = x * x;
        let x3 = x2 * x;
        let term3 = -x3;
        let term2 = c2 * x2;
        let term1 = -(c1 * x);
        return term3 + term2 + term1 + c0;
    }

    /** 
     * Computes real integer eigenvalues by finding roots of det(A - lambda*I) = 0.
     * Evaluates coefficients: c2 = tr(A), c1 = sum of principal minors, c0 = det(A).
     */
    function void computeEigenvalues(Tensor a, Tensor evals) {
        var int c2, c1, c0;
        var int m00, m11, m22;
        var int x, val, count;

        let c2 = Matrix3x3.trace(a);
        let c0 = Matrix3x3.determinant(a);

        // Sum of 2x2 principal minors
        let m00 = Matrix3x3.det2x2(a.at(1, 1), a.at(1, 2), a.at(2, 1), a.at(2, 2));
        let m11 = Matrix3x3.det2x2(a.at(0, 0), a.at(0, 2), a.at(2, 0), a.at(2, 2));
        let m22 = Matrix3x3.det2x2(a.at(0, 0), a.at(0, 1), a.at(1, 0), a.at(1, 1));
        let c1  = m00 + m11 + m22;

        // Initialize eigenvalue output to 0
        do evals.fill(0);

        // Search bounded integer spectrum [-50, 50] for roots p(x) == 0
        let count = 0;
        let x = -50;
        while ((x < 51) & (count < 3)) {
            let val = Matrix3x3.evalPoly(x, c2, c1, c0);
            if (val = 0) {
                do evals.set(count, x);
                let count = count + 1;
            }
            let x = x + 1;
        }
        return;
    }

    // =========================================================================
    // Display Helper
    // =========================================================================

    /** Prints a clean 3x3 matrix grid without Tensor headers */
    function void printMatrix(Tensor m) {
        var int r, c;
        let r = 0;
        while (r < 3) {
            let c = 0;
            while (c < 3) {
                do Output.printInt(m.at(r, c));
                if (c < 2) {
                    do Output.printString(" ");
                }
                let c = c + 1;
            }
            do Output.println();
            let r = r + 1;
        }
        return;
    }
}